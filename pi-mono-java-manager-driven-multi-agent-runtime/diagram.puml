@startuml metadata_runtime_directory_mapping
title Metadata to Managed Agent Runtime Directory

' Source evidence:
' pi-mono packages/coding-agent/src/core/skills.ts: Skill, loadSkillFromFile, formatSkillsForPrompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/context/ContextFileLoader.java: loadSystemPrompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java: loadSkills
' Observed behavior: pi and pi-mono-java discover Skill metadata from SKILL.md frontmatter.
' Java divergence: the target compiler materializes only one controlled Agent directory.
' Design reason: keep Agent-specific disclosure local while Managers remain runtime authorities.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam file {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
  FontColor #0F172A
}
skinparam ArrowColor #475569

rectangle "Resolved metadata input" as Input {
  rectangle "AGENT\nid, system_prompt\nmodels, bindings, policy" as AgentMetadata
  rectangle "SKILL\nname, description, content\nskill and tool bindings" as SkillMetadata
  rectangle "TOOL\nid, name, description\nschema, source, permission" as ToolMetadata
}

rectangle "Runtime bundle compiler" as Compiler {
  rectangle "Validate versions,\ndependency closure,\nnames and permissions" as Validate
  rectangle "Render prompt and\nSkill resources" as Render
  rectangle "Publish Agent directory\natomically" as Publish
}

rectangle "Controlled Agent directory\n<agent-runtime-root>/<agent-id>/" as AgentDirectory {
  file ".campusclaw/SYSTEM.md\nAgent instructions\nDirect Agent tool summaries" as SystemFile
  file ".campusclaw/skills/<skill-name>/SKILL.md\nFrontmatter and Skill content" as SkillFile
  file ".campusclaw/skills/<skill-name>/references/tools.json\nDirect Skill tool summaries" as SkillToolsFile
}

database "Agent metadata authority\nAgent model and binding policy" as AgentAuthority
database "Tool Manager authority\nTool schema, status,\npermission and execution" as ToolManager
database "Model Manager authority\nModel descriptor,\nallowlist and invocation" as ModelManager
file "<runtime-data-root>/sessions/<agent-id>/\n<session-id>.jsonl" as SessionFile

AgentMetadata --> Validate
SkillMetadata --> Validate
ToolMetadata --> Validate
Validate --> Render
Render --> Publish
Publish --> SystemFile : system_prompt and direct tools
Publish --> SkillFile : name, description and content
Publish --> SkillToolsFile : direct Skill tools

AgentMetadata ..> AgentAuthority : publish metadata
ToolMetadata ..> ToolManager : publish executable definition
AgentMetadata ..> ModelManager : authorize model ids
AgentDirectory ..> SessionFile : cwd and Agent isolation

note right of SkillToolsFile
Only tool_id, name and description.
Schemas stay in Tool Manager.
Child Skill tools are not merged.
end note
@enduml

@startuml managed_session_context_assembly
title Managed Multi-Agent Session and Context Assembly

' Source evidence:
' pi-mono packages/ai/src/types.ts: Context
' pi-mono packages/coding-agent/src/core/system-prompt.ts: buildSystemPrompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java: initialize
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/mode/server/SessionPool.java: getOrCreate
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/mode/server/ServerMode.java: websocket route
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/mode/server/ChatWebSocketHandler.java: handle
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/loop/AgentLoop.java: invokeModel, toLlmTools
' Observed behavior: Java currently reads conversation_id during Upgrade and uses one base cwd.
' Java divergence: v2 authenticates Upgrade and maps closed Frames to a server-side SessionTransport.
' Architecture change: ManagedSessionTransport owns logical connection state; WebSocket is an adapter.
' Target design: globally unique session_id is the only SessionPool key; tenant and user stay upstream.
' Target design: a wss URI starts establishment; HTTP 101 establishes WebSocket transport.
' Target design: HTTP Upgrade and the first connect RequestFrame are separate protocol phases.
' Design reason: isolate prompt, model, tool, persistence, and run recovery across Agents.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "Calling session service" as Client
participant "Upgrade auth" as Auth
participant "ChatWebSocketAdapter" as WS
participant "SessionTransportFactory" as TransportFactory
participant "ManagedSessionTransport" as Transport
participant "AgentDirectoryResolver" as Resolver
participant "ManagedSessionPool" as Pool
participant "ManagedAgentSessionFactory" as Factory
participant "Model Manager" as ModelManager
participant "AgentSession" as Session
participant "AgentLoop" as Loop
participant "ManagedRunHub" as Hub
database "Runtime session store" as Store

Client -> Client : call WebSocket library\nconnect(wss URI)
Client -> Auth : one TCP connection, TLS, then\nHTTP/1.1 GET /api/ws/chat\nUpgrade headers and service Bearer
Auth -> Auth : complete TLS or mTLS\nvalidate service principal and Upgrade
Auth --> Client : HTTP/1.1 101 Switching Protocols
Auth --> WS : immutable connection auth context
WS -> TransportFactory : open(auth context)
TransportFactory --> WS : per-connection transport
Client -> WS : WebSocket Text Frame\nRequestFrame connect\nmode, session_id, agent_id, model_id?
WS -> WS : validate closed Frame\nand optional traceparent
WS -> Transport : connect(command, invocation metadata)
Transport -> Resolver : resolve(agent_id)
Resolver -> Resolver : normalize and verify controlled root
Resolver --> Transport : agentCwd
Transport -> Pool : open(session_id, agent_id, model_id?)

alt mode=create
  Pool -> ModelManager : resolveModel(agent_id, model_id)
  ModelManager --> Pool : ModelDescriptor
else mode=resume
  Pool -> Store : load(session_id)
  Store --> Pool : messages and saved model_id
  Pool -> ModelManager : resolveModel(agent_id, effective model_id)
  ModelManager --> Pool : current ModelDescriptor
end

Pool -> Factory : create(session_id, agent_id,\nagentCwd, descriptor, restored messages)
Factory -> Factory : load controlled SYSTEM.md and Skills
Factory -> Factory : register read, get_tool_info, call_tool
Factory -> Session : initialize isolated Session
Session -> Loop : systemPrompt, messages, AgentTools
Loop -> Loop : map AgentTools to Context.tools
Loop --> Pool : ready
Pool -> Hub : get active run for session_id
Transport -> Hub : atomically register logical subscription\nand capture cursor plus snapshot
Hub --> Transport : active_run snapshot and buffered publisher
Transport --> WS : SessionConnectResult
WS --> Client : ResponseFrame payload with session_id,\nmodel, limits, features, active_run
WS -> Transport : subscribe to events() after response write
Hub --> Transport : SessionEvents after snapshot cursor
Transport --> WS : ordered typed events
WS --> Client : EventFrames with connection seq

note over Factory,Loop
Managed prompt inputs:
Agent SYSTEM, three generic tools,
native Skill summaries, and cwd only.
end note

note over Pool,Store
Isolation key:
globally unique session_id
agent_id is an immutable binding.
Tenant and user belong upstream.
The run is owned by Pool and Hub,
not by the transport or WebSocket.
end note
@enduml

@startuml progressive_tool_discovery_execution
title Progressive Tool Discovery and Execution

' Source evidence:
' pi-mono packages/coding-agent/src/core/skills.ts: formatSkillsForPrompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/skill/SkillPromptFormatter.java: format
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/tool/AgentTool.java: AgentTool
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/loop/AgentLoop.java: toLlmTools
' Observed behavior: Java sends every registered AgentTool name, description and schema to the model.
' Architecture change: business tools are disclosed as logical ids and executed by two generic tools.
' Design reason: Tool Manager owns live schema, authorization and execution without dynamic registration.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor User
participant Model
participant "read" as Read
participant "get_tool_info" as GetInfo
participant "call_tool" as CallTool
database "Agent SYSTEM.md" as AgentSystem
database "Skill files" as SkillFiles
participant "Tool Manager" as ToolManager
database "Agent metadata authority" as AgentAuthority

Model -> AgentSystem : receive direct Agent tool summaries\nin system prompt

alt task matches a Skill
  Model -> Read : read(SKILL.md)
  Read -> SkillFiles : load Skill content
  SkillFiles --> Read : instructions
  Read --> Model : Skill instructions
  opt Skill needs an external operation
    Model -> Read : read(references/tools.json)
    Read -> SkillFiles : load direct Skill tool summaries
    SkillFiles --> Read : tool_id, name, description
    Read --> Model : logical Skill tools
  end
end

Model -> GetInfo : get_tool_info(tool_id)
GetInfo -> ToolManager : getToolInfo(agent_id, tool_id)
ToolManager -> AgentAuthority : validate Agent binding and policy
AgentAuthority --> ToolManager : authorized binding
ToolManager --> GetInfo : live description and schemas
GetInfo --> Model : tool metadata

Model -> CallTool : call_tool(tool_id, parameters)
CallTool -> ToolManager : callTool(agent_id, session_id,\ntool_id, parameters)
ToolManager -> AgentAuthority : revalidate binding and permission
AgentAuthority --> ToolManager : current policy
ToolManager -> ToolManager : validate status and input schema
ToolManager -> ToolManager : execute and validate output
ToolManager --> CallTool : result or structured error
CallTool --> Model : Tool result
Model --> User : final response

note over GetInfo,CallTool
Their descriptions define the protocol:
discover the live schema before execution.
Prompt disclosure never grants permission.
end note
@enduml

@startuml managed_websocket_session_protocol
title Managed WebSocket Session Protocol

' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/mode/server/ServerMode.java: websocket route
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/mode/server/ChatWebSocketHandler.java: handle, onAgentEvent
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/event/MessageUpdateEvent.java: message, assistantMessageEvent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/stream/AssistantMessageEvent.java: typed deltas
' OpenClaw baseline: b015925bc30f6a8363f290b07d5f8588e21422b8, Gateway Protocol v4
' openclaw packages/gateway-protocol/src/schema/frames.ts: RequestFrameSchema, GatewayFrameSchema
' openclaw packages/gateway-protocol/src/schema/logs-chat.ts: ChatDeltaEventSchema
' openclaw docs/gateway/clients.md: Recover state after reconnect
' openclaw src/gateway/server-broadcast.ts: createGatewayBroadcaster
' Observed behavior: Java v1 captures one Session per connection, emits cumulative Message updates,
' and aborts AgentSession when the WebSocket closes.
' Java divergence: v2 maps Frame payloads to typed SessionTransport requests and events.
' Architecture change: one connection is scoped to one caller-owned session and Agent, unlike OpenClaw Gateway multiplexing.
' Target design: the Runtime authenticates a calling service and does not model tenant or user identity.
' Target design: calling connect with a wss URI does not mean WebSocket is already established.
' Target design: HTTP 101 establishes transport; connect RequestFrame binds the Runtime Session.
' Design reason: provide auditable ToB isolation and race-free recovery without moving run ownership to transport.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "Calling session service" as Client
participant "Upgrade auth" as Auth
participant "ChatWebSocketAdapter" as WS
participant "ManagedSessionTransport" as Transport
participant "ManagedSessionPool" as Pool
participant "ManagedRunHub" as Hub
participant "AgentSession" as Session
participant "Thinking projection" as Projection
database "Session JSONL" as Store

Client -> Client : call WebSocket library\nconnect(wss URI)
Client -> Auth : one TCP connection, TLS, then\nHTTP/1.1 GET /api/ws/chat\nUpgrade headers and service Bearer
Auth -> Auth : complete TLS or mTLS\nreject URL token and business query\nvalidate service principal and Upgrade
Auth --> Client : HTTP/1.1 101 Switching Protocols
Auth -> WS : immutable auth context
WS -> Transport : create per-connection transport
Client -> WS : WebSocket Text Frame within 5 seconds\nRequestFrame connect\nmode, session_id, agent_id, model_id?
WS -> WS : validate traceparent and closed Frame
WS -> Transport : connect(command, invocation metadata)
Transport -> Pool : resolve session_id or create binding\nand validate effective model
Pool -> Hub : atomic subscribe and snapshot
Hub --> Transport : cursor, active_run, buffered publisher
Transport --> WS : SessionConnectResult
WS --> Client : ResponseFrame payload with connection_id,\nsession_id, agent_id, model, active_run
WS -> Transport : subscribe to events()
Hub --> Transport : events after cursor

alt idle session
  Client -> WS : RequestFrame chat.send\nwith idempotency_key and traceparent?
  WS -> Transport : request(ChatSend, metadata)
  Transport -> Pool : atomically create primary run
  Pool -> Session : prompt(message, attachments)
  Pool --> Transport : run_id and accepted
  Transport --> WS : SessionResponse
  WS --> Client : ResponseFrame ok with payload
  Session -> Hub : AssistantMessageEvent delta
  Hub -> Projection : project for fixed run policy
  Projection --> Hub : safe structured delta
  Hub -> Hub : increment run_seq and update snapshot
  Hub --> Transport : typed SessionEvents
  Transport --> WS : run, message, and tool events
  WS -> WS : increment connection seq
  WS --> Client : EventFrames
else active session
  Client -> WS : RequestFrame chat.send
  WS -> Transport : request(ChatSend, metadata)
  Transport --> WS : RUN_ACTIVE
  WS --> Client : ResponseFrame error
end

alt transport disconnects while run is active
  Client -x WS : connection closed
  WS -> Transport : close()
  Transport -> Hub : unsubscribe only
  note over Pool,Session
  The run continues.
  No AgentSession abort is called.
  end note
  Session -> Hub : further deltas or terminal event
  Hub -> Store : persist final Message and run outcome
  Client -> Auth : reconnect and authenticate
  Auth --> Client : 101 Switching Protocols
  Auth -> WS : new immutable auth context
  WS -> Transport : create new transport
  Client -> WS : RequestFrame connect for same session_id
  WS -> Transport : connect(command, metadata)
  Transport -> Pool : resolve existing Session
  Pool -> Hub : atomic logical subscribe and snapshot
  Hub --> Transport : cursor, partial Message, active tools
  Transport --> WS : SessionConnectResult
  WS --> Client : ResponseFrame snapshot first
  WS -> Transport : subscribe to events()
  Hub --> Transport : deltas with run_seq after snapshot
  Transport --> WS : typed events
  WS --> Client : ordered EventFrames
end

alt explicit abort
  Client -> WS : RequestFrame chat.abort(run_id)
  WS -> Transport : request(ChatAbort, metadata)
  Transport -> Pool : abort active run idempotently
  Pool -> Session : abort()
  Session -> Hub : run.completed(aborted)
else slow consumer
  WS --> Client : close 1013
  note over Client,Hub
  No delta is silently dropped.
  Reconnect obtains a new snapshot.
  end note
end

note over WS,Hub
Event seq is connection-local.
run_seq is continuous across reconnects.
Snapshot response is sent before post-cursor deltas.
end note

note over Client,WS
The wss URI is an establishment request.
Before HTTP 101, failures use HTTP status.
After HTTP 101, messages are WebSocket Frames.
HTTP Upgrade does not create a Runtime Session.
end note

note over Client,Session
Core runtime identities:
connection_id, session_id, agent_id,
model_id, message_id, and run_id.
Frame id and tool_call_id are local correlations.
end note
@enduml

@startuml managed_session_transport_dependency_inversion
title Managed Session Transport Dependency Inversion

' OpenClaw baseline: b015925bc30f6a8363f290b07d5f8588e21422b8, Gateway Protocol v4
' Source: packages/sdk/src/types.ts (OpenClawTransport, ConnectableOpenClawTransport)
' Source: packages/sdk/src/transport.ts (GatewayClientTransport)
' Source: src/gateway/server-methods/shared-types.ts (GatewayRequestHandler, RespondFn)
' Source: src/gateway/server/ws-types.ts (GatewayWsClient)
' Source: src/gateway/server-broadcast.ts (createGatewayBroadcaster)
' Observed behavior: OpenClaw fully inverts the client SDK transport dependency.
' Observed behavior: OpenClaw server handlers are frame-neutral, but broadcast still owns WebSocket objects.
' Current Java behavior: ChatWebSocketHandler directly owns AgentSession command and close behavior.
' Target design: CampusClaw exposes one server-side SessionTransport per physical connection.
' Design reason: keep Session and run semantics independent from WebSocket while preserving a small API.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #475569

package "Network adapters" as Adapters {
  component "ChatWebSocketAdapter\nFrame codec, trace context,\nseq, flow control, close codes" as WebSocketAdapter
  component "Future REST plus SSE adapter\nnot part of protocol v2" as FutureAdapter
}

package "Application ports" as Ports {
  interface "SessionTransportFactory\nopen(authContext)" as TransportFactory
  interface "SessionTransport\nconnect(command, metadata)\nrequest(request, metadata)\nevents()\nclose()" as TransportPort
}

package "Managed runtime" as Runtime {
  component "ManagedSessionTransport\nstate: NEW, CONNECTING,\nCONNECTED, CLOSED" as ManagedTransport
  component "ManagedSessionPool" as Pool
  component "ManagedRunHub" as Hub
  component "Model and Tool Managers" as Managers
}

WebSocketAdapter --> TransportFactory : immutable auth context
TransportFactory --> ManagedTransport : create per connection
ManagedTransport ..|> TransportPort
WebSocketAdapter --> TransportPort : typed connect and requests
TransportPort --> WebSocketAdapter : Flow Publisher of SessionEvents
ManagedTransport --> Pool : Session commands
ManagedTransport --> Hub : atomic snapshot and event stream
ManagedTransport --> Managers : propagated Trace Context
FutureAdapter ..> TransportPort : future adapter only

note bottom of Ports
The port contains no WebSocket, JSON,
Spring session, or close-code types.
end note

note bottom of Runtime
close removes the subscription only.
The active run remains owned by Pool and Hub.
end note
@enduml

@startuml model_manager_streaming_flow
title Model Manager Provider Streaming Flow

' Source evidence:
' pi-mono packages/ai/src/types.ts: Model, Context, AssistantMessageEvent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProvider.java: ApiProvider
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProviderRegistry.java: ApiProviderRegistry
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/SimpleStreamOptions.java: metadata
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/stream/AssistantMessageEvent.java: event records
' Observed behavior: Java dispatches by Model.api to a Spring-discovered ApiProvider.
' Architecture change: one MODEL_MANAGER Api routes every managed model through Model Manager.
' Design reason: model_id selects the model while agent_id authorizes it for the current Agent.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor Client
participant "AgentLoop" as Loop
participant "CampusClawAiService" as AiService
participant "ApiProviderRegistry" as Registry
participant "ModelManagerApiProvider" as Provider
participant "Model Manager" as ModelManager

Client -> Loop : prompt
Loop -> AiService : stream(model, Context, options)
AiService -> Registry : getProvider(MODEL_MANAGER)
Registry --> AiService : ModelManagerApiProvider
AiService -> Provider : streamSimple(model, Context, metadata)
Provider -> Provider : require immutable agent_id,\nsession_id, and Trace Context
Provider -> ModelManager : invoke(agent_id, model.id,\nContext, mapped options)
ModelManager -> ModelManager : revalidate Agent model binding

loop stream events
  ModelManager --> Provider : start, content delta,\ntool call, done or error
  Provider --> Loop : AssistantMessageEvent
end

alt explicit run abort
  Client -> Loop : chat.abort(run_id)
  Loop -> Provider : cancel model subscription
  Provider -> ModelManager : close stream
end

note over Provider,ModelManager
The Provider maps events only.
Tool execution remains in AgentLoop.
No fallback to built-in providers.
end note
@enduml
