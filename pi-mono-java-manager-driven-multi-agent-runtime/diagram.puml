Client -> WS : establish wss with\nBearer or mTLS
WS --> Client : HTTP 101
Client -> WS : req connect create or resume
WS -> Pool : bind session and agent
Pool -> Hub : atomic snapshot and cursor
Hub --> Pool : active_run or null
Pool --> WS : connect result
WS --> Client : res connect payload first
Client -> Reducer : enter sync and buffer post-snapshot events

alt idle session
  Client -> WS : req chat.send\nmessage and idempotency key
  WS -> Pool : persist user message and\natomically reserve run
  Pool --> WS : run_id and user_message_id
  WS --> Client : res chat.send before origin events
  Client -> Reducer : reconcile optimistic user message
  Hub --> WS : run, message, and tool events
  WS --> Client : typed EventFrames
  Client -> Reducer : verify seq and run_seq\nthen reduce by content_index
  WS --> Client : message.completed\nthen run.completed
  Client -> Reducer : replace partial message\nthen clear active run
else active session
  Client -> WS : req chat.send
  WS --> Client : res error RUN_ACTIVE
end

