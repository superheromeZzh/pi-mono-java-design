' Java divergence: current get-or-create is not single-flight, initialization is synchronous, and disconnect aborts a streaming run.
' Target-only design: one lifecycle slot owns initialization, connection generation, run state, eviction, and cleanup.
' Design reason: a session must have one resident owner and one active writer even under reconnect and eviction races.
@startuml session_lifecycle_single_flight
title Session Single-Flight, Connection Fencing, and Safe Eviction

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center
skinparam ArrowColor #374151

actor "Connection C1" as c1
actor "Connection C2" as c2
participant "SessionLifecycleRegistry" as registry
participant "SessionLifecycleSlot" as slot
participant "Session Init Gate\n2 active / 32 waiting" as init_gate
participant "Virtual-Thread Init Task" as init_task
participant "Immutable Template Cache" as cache
database "RuntimeSessionStore" as store

par concurrent create or resume
  c1 -> registry : acquire(session_id, binding)
  registry -> slot : computeIfAbsent
  slot -> init_gate : initialize once
else second caller
  c2 -> registry : acquire(same session_id, same binding)
  registry -> slot : return same slot
  slot --> c2 : join the same readiness future
end

init_gate -> init_task : grant init lease
init_task -> cache : acquire exact immutable template
init_task -> store : restore bounded session snapshot
init_task -> slot : publish READY once
slot --> c1 : bind generation N
slot --> c2 : bind generation N + 1
slot --> c1 : close 4409 SESSION_REPLACED

c2 -> slot : chat.send
slot -> slot : READY to ADMITTING to ACTIVE
... active run continues ...
c2 -> slot : physical connection closes
slot -> slot : remove subscriber only
note right of slot
  Disconnect is not abort.
  Explicit chat.abort owns cancellation.
end note

slot -> slot : touch on command, event, and run transition
alt no connection AND no active run AND idle timeout reached
  slot -> store : flush final state
  slot -> cache : release template reference
  slot -> registry : remove exact slot and release resident lease
else connected or active
  slot -> slot : skip eviction
end
@enduml
