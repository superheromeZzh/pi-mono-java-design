@startuml target_two_node_capacity_architecture
title Target Two-Node High-Concurrency Architecture

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #374151

actor "Agent UI" as ui
cloud "mate-service\npublic protocol, quota, affinity, scheduler" as mate

node "VM A - agent-service\n4 vCPU / 8 GiB" as node_a {
  component "Connection Admission\n600 connections" as conn_a
  component "SessionLifecycleRegistry\n600 resident sessions" as session_a
  component "Run Capacity Manager\n500 active + 100 waiting" as run_a
  component "ManagedRunHub\nbounded delta fan-out" as hub_a
  component "Immutable Template Cache" as template_a
  component "Model / Tool / Store Bulkheads" as bulkhead_a
  component "Runtime Metrics and Heartbeat" as metrics_a
}

node "VM B - agent-service\n4 vCPU / 8 GiB" as node_b {
  component "Same authoritative limits" as limits_b
  component "Independent active runs" as runs_b
  component "Runtime Metrics and Heartbeat" as metrics_b
}

database "RuntimeSessionStore\nshared authoritative state" as store
cloud "Model Manager and Provider\nexternal stream quota" as model
cloud "Tool Manager\nexternal tool quota" as tool
component "Metrics Backend\nand Alerting" as telemetry

ui --> mate : public Chat WebSocket
mate --> conn_a : new session when A has capacity
mate --> limits_b : new session when B has capacity
mate --> conn_a : existing session affinity
mate --> limits_b : existing session affinity

conn_a --> session_a
session_a --> run_a
template_a --> session_a : immutable shared template
run_a --> hub_a
run_a --> bulkhead_a
bulkhead_a --> model : bounded stream
bulkhead_a --> tool : bounded call
session_a --> store : load and persist
hub_a --> store : terminal and recovery state
metrics_a --> telemetry
metrics_b --> telemetry
metrics_a ..> mate : heartbeat snapshot
metrics_b ..> mate : heartbeat snapshot

note bottom of run_a
  A virtual thread starts only
  after a run lease is granted.
end note

note bottom of node_b
  Healthy-cluster target: 1000 active runs.
  One-node-loss capacity: 500 active runs.
end note

note right of mate
  Scheduling is advisory.
  A selected node may still reject
  stale or racing admission requests.
end note
@enduml

' Source evidence: modules/agent-core/src/main/java/com/campusclaw/agent/Agent.java:218-268
' Source evidence: modules/agent-core/src/main/java/com/campusclaw/agent/tool/ToolExecutionPipeline.java:187-207
' Observed behavior: Agent already rejects a second run in one Agent and starts one new virtual thread per run.
' Target-only design: admission uses an asynchronous bounded descriptor queue before creating the run virtual thread.
' Design reason: virtual-thread count is not a capacity limit; count and byte leases protect memory and downstream resources.
@startuml run_admission_and_execution
title Run Admission, Execution, and Exact Lease Release

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center
skinparam ArrowColor #374151

actor "mate-service Bridge" as bridge
participant "SessionLifecycleSlot" as slot
participant "RunCapacityManager" as capacity
queue "Bounded PendingRun Queue\n100 items / 64 MiB / 10 s" as queue
database "RuntimeSessionStore" as store
participant "Response/Event Fence" as fence
participant "Virtual-Thread Executor" as executor
participant "AgentLoop" as loop
participant "Model Gate" as model_gate
participant "Tool Gate" as tool_gate

bridge -> slot : chat.send(session_id, idempotency_key)
slot -> slot : reserve ADMITTING state

alt another run is ADMITTING or ACTIVE
  slot --> bridge : RUN_ACTIVE
else session run slot reserved
  slot -> capacity : acquireAsync(count=1, weighted bytes)
  alt count and byte permits available
    capacity --> slot : RunLease
  else queue has item and byte capacity
    capacity -> queue : enqueue immutable PendingRun
    queue -> queue : wait no longer than 10 s
    alt capacity becomes available
      queue --> slot : RunLease
    else timeout or cancellation
      queue --> slot : admission rejected
      slot -> slot : clear ADMITTING state
      slot --> bridge : RUNTIME_OVERLOADED and retry_after_ms
    end
  else queue is full
    capacity --> slot : admission rejected
    slot -> slot : clear ADMITTING state
    slot --> bridge : RUNTIME_OVERLOADED and retry_after_ms
  end
end

slot -> store : atomically persist user message and run
store --> slot : accepted run_id
slot -> fence : install response-before-event fence
fence --> bridge : accepted response
fence -> executor : start one new virtual thread
executor -> loop : execute run

loop -> model_gate : acquire model-stream lease
model_gate --> loop : stream lease
loop -> loop : CPU bursts mount on a carrier
loop -> model_gate : release on completion, error, or cancel

opt tool calls
  loop -> tool_gate : acquire global and per-run leases
  tool_gate --> loop : up to 4 calls for this run
  loop -> tool_gate : release every child lease
end

loop -> store : persist terminal result first
loop -> fence : publish terminal event
loop -> capacity : close RunLease exactly once
loop -> slot : ACTIVE to READY
@enduml

