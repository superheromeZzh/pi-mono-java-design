' Java divergence: current streams and WebSocket sinks are unbounded and message_update carries a cumulative Message.
' Target-only design: bounded typed deltas, aggregate byte accounting, and connection-only slow-consumer eviction.
' Design reason: terminal state must survive a slow or disconnected client without allowing unbounded memory growth.
@startuml bounded_stream_and_slow_consumer
title Bounded Delta Streaming and Slow-Consumer Isolation

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #374151

cloud "Model Provider" as provider
component "Shared pooled model client" as model_client

rectangle "Run-Local Stream Path" as run_path {
  queue "Bounded model channel\n256 events AND 256 KiB" as model_channel
  component "AssistantMessageAccumulator\nno full clone per delta" as accumulator
  component "Typed delta coalescer\n50 ms OR 8 KiB" as coalescer
  component "ManagedRunHub\nlatest snapshot + ordered run_seq" as hub
  queue "Reserved control lane\nterminal events never dropped" as control_lane
}

database "RuntimeSessionStore\nterminal and recovery state" as store

rectangle "Connection-Local Stream Path" as conn_path {
  component "Connection subscriber" as subscriber
  queue "Send buffer\n4 MiB per connection" as send_buffer
  component "Node buffer budget\n256 MiB aggregate" as node_budget
  component "WebSocket adapter" as adapter
}

actor "Fast Client" as fast
actor "Slow Client" as slow

provider --> model_client : streaming response
model_client --> model_channel : block producer when full
model_channel --> accumulator : consume in order
accumulator --> coalescer : delta only
coalescer --> hub : at most 20 frames per second
accumulator --> control_lane : lifecycle and terminal
control_lane --> hub
hub --> store : persist terminal before publish
hub --> subscriber : demand-aware subscription
subscriber --> node_budget : reserve serialized bytes
node_budget --> send_buffer : budget granted
send_buffer --> adapter : ordered frame
adapter --> fast : send succeeds
adapter --> node_budget : release sent bytes

send_buffer --> slow : send cannot keep up
node_budget --> adapter : per-connection or node budget exhausted
adapter --> slow : close 1013
adapter --> subscriber : cancel only this subscription

note right of hub
  The run continues without
  a physical connection.
end note

note bottom of model_channel
  Internal backpressure is separate
  from client connection pressure.
end note

note bottom of node_budget
  The 4 MiB connection limit is not
  eagerly reserved for every client.
end note
@enduml

