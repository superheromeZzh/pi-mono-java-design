@startuml memory-architecture
!pragma layout smetana
title Java Centralized GaussDB Session Memory
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionStorage
' - packages/agent/src/harness/session/repository.ts: SessionRepository
' - packages/agent/src/harness/session/session.ts: Session and buildSessionContext
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: SqliteSessionConnection
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: CachedBranch and rebuildCachedBranch
' - packages/storage/sqlite-node/src/sqlite/search-backend.ts: ensureSearchSchema and search
' Observed behavior: pi separates session semantics from storage in the new harness.
' Design reason: keep context semantics in Java and make GaussDB the durable source.
' Java divergence: JDBC revisions and idempotency are target-only; session storage behavior aligns with SQLite.
' Product constraint: this design has no tenant model or cross-session memory.

package "Agent Application" {
  [Agent Runtime] as runtime
  [Memory Session Application Service] as memory
  [Context Rebuilder] as context
  [Compaction Coordinator] as compact
  [Branch Summary Coordinator] as branch
  [Import And Export Service] as migration
}

package "GaussDB JDBC Adapter" {
  [Session Repository] as sessionRepo
  [Entry Repository] as entryRepo
  [Branch Cache Repository] as branchRepo
  [Session Search Repository] as searchRepo
  [Write Operation Repository] as operationRepo
  [JSONB JDBC Codec] as jsonCodec
}

database "Centralized GaussDB" as db

runtime --> memory : session commands
memory --> context : active path snapshot
memory --> compact : prepare and commit
memory --> branch : prepare and commit
migration --> memory : import and export
memory --> sessionRepo : header and state
memory --> entryRepo : immutable entries
memory --> branchRepo : cached branch queries
memory --> searchRepo : substring search
memory --> operationRepo : idempotent writes
entryRepo --> jsonCodec : payload mapping
sessionRepo --> db
entryRepo --> db
branchRepo --> db
searchRepo --> db
operationRepo --> db
compact --> memory : summary result
branch --> memory : summary result
context --> runtime : context snapshot

note bottom of jsonCodec
openGauss JDBC
6.0.0-htrunks.csi.gaussdb_kernel.opengaussjdbc.r1
end note

@enduml

@startuml memory-write-transaction
title Append Move And Summary Transactions
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/session/session.ts: appendTypedEntry and moveTo
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry and readPathToRootOrCompaction
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: appendEntryToBranchCache
' - packages/agent/src/harness/compaction/compaction.ts: prepareCompaction and compact
' Observed behavior: pi stores leaf markers and generates summaries before append.
' Design reason: commit entry, projections, leaf state, and operation atomically.
' Java divergence: revision checks and idempotency are target-only reliability changes.

actor "Agent Runtime" as runtime
participant "Memory Service" as memory
participant "Summary Model" as model
database "Centralized GaussDB" as db

== Append or move ==
runtime -> memory : command(operationId, expectedRevision, expectedLeaf)
group short database transaction
  memory -> db : reserve or read write operation
  alt committed retry
    db --> memory : stored result
    memory --> runtime : stored result
  else new operation
    memory -> db : lock session head
    memory -> db : verify revision and leaf
    alt append
      memory -> db : insert immutable entry
      memory -> db : set current leaf to new entry
    else move
      memory -> db : insert leaf marker
      memory -> db : set current leaf to target
    end
    memory -> db : update sequence and materialized state
    memory -> db : extend or repair branch cache
    memory -> db : update search projection and revision
    memory -> db : commit stable result
    memory --> runtime : success
  end
end

== Compaction or branch summary ==
runtime -> memory : prepare summary
memory -> db : read cached branch, revision, and leaf
db --> memory : immutable snapshot
memory -> model : generate outside transaction
model --> memory : summary result
memory -> db : lock state and verify snapshot
alt snapshot changed
  db --> memory : stale snapshot
  memory --> runtime : STALE_CONTEXT_SNAPSHOT
else snapshot unchanged
  alt compaction
    memory -> db : insert compaction entry
  else branch summary
    memory -> db : insert leaf marker and branch summary
  end
  memory -> db : update all SQLite-aligned projections
  memory -> db : update leaf, revision, and operation
  db --> memory : committed
  memory --> runtime : success
end

@enduml

@startuml memory-data-model
title Session Event Plane Data Model
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBorderColor #53657D
skinparam classBackgroundColor #F7F9FC

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionTreeEntry and SessionStorage
' - packages/storage/sqlite-node/src/sqlite/migrations/001_initial.sql and 002_branch_tips.sql
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: CachedBranch and appendEntryToBranchCache
' - packages/storage/sqlite-node/src/sqlite/search-backend.ts: ensureSearchSchema
' Observed behavior: pi stores an immutable entry tree plus current leaf state.
' Design reason: separate stable session headers, mutable state, facts, and projections.
' Java divergence: foreign keys, revisions, and write operations are target-only.
' Observed behavior: SQLite branch tables are derived caches, and canonical parent links remain authoritative.
' Design reason: preserve SQLite branch-query behavior while allowing recursive cache repair.
' Design reason: retain entry payload text because SQLite FTS indexes the original payload column.
' Architecture change: a normalized search projection replaces SQLite FTS5 virtual and shadow tables.

class "agent_session" as agent_session <<table>> {
  session_id : varchar(128) [PK]
  --
  created_at : timestamptz
  cwd : text
  parent_session_id : varchar(128) [logical]
  metadata : jsonb [nullable]
  active_leaf_entry_id : varchar(128) [logical]
  revision : bigint
}

class "session_sequence" as session_sequence <<table>> {
  session_id : varchar(128) [PK, FK]
  --
  next_append_seq : bigint
}

class "session_materialized" as session_materialized <<projection>> {
  session_id : varchar(128) [PK, FK]
  --
  payload : jsonb
}

class "session_entry" as session_entry <<table>> {
  session_id : varchar(128) [PK, FK]
  entry_id : varchar(128) [PK]
  --
  parent_entry_id : varchar(128) [FK]
  append_seq : bigint [UQ]
  entry_type : varchar(64)
  payload : text
  operation_id : varchar(128) [FK]
}

class "session_write_operation" as write_operation <<table>> {
  operation_id : varchar(128) [PK]
  --
  session_id : varchar(128) [reference]
  operation_type : varchar(32)
  request_hash : char(64)
  status : varchar(16)
  result_payload : jsonb
}

class "entry_materialized" as entry_materialized <<projection>> {
  session_id : varchar(128) [PK, FK]
  append_seq : bigint [PK, FK]
  --
  projection_type : varchar(64) [PK]
  payload : jsonb
}

class "branch_entry" as branch_entry <<cache>> {
  session_id : varchar(128) [PK, FK]
  branch_id : varchar(128) [PK]
  entry_id : varchar(128) [PK, FK]
  append_seq : bigint
}

class "branch_tip" as branch_tip <<cache>> {
  session_id : varchar(128) [PK, FK]
  tip_id : varchar(128) [PK, FK]
  --
  branch_id : varchar(128) [UQ]
}

class "session_search_document" as search_document <<projection>> {
  session_id : varchar(128) [PK, FK]
  entry_id : varchar(128) [PK, FK]
  --
  normalized_text : text
}

agent_session ||--|| session_sequence : owns append sequence
agent_session ||--|| session_materialized : owns summary projection
agent_session ||--o{ session_entry : owns immutable tree
write_operation ..> agent_session : targets session id
session_entry ||--o{ session_entry : parent
write_operation ||--o{ session_entry : commits
session_entry ||--o{ entry_materialized : derives entry projection
session_entry ||--o{ branch_entry : caches path membership
session_entry ||--o| branch_tip : may be cached tip
session_entry ||--o| search_document : derives search text
branch_tip ..> branch_entry : identifies cached branch
agent_session ..> session_entry : logical active leaf

note bottom of session_entry
Leaf navigation is an entry.
The session head points to leaf.targetId,
not to the leaf marker itself.
Payload text preserves SQLite search input.
end note

note bottom of branch_entry
Branch rows are rebuildable caches.
Parent links remain authoritative.
end note

note bottom of session_materialized
Payload follows SQLite projector rules.
It is append-log summary, not context state.
end note

@enduml

@startuml memory-context-rebuild
title Centralized GaussDB Context Rebuild
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/session/session.ts: defaultContextEntryTransform
' - packages/agent/src/harness/session/session.ts: sessionEntryToContextMessages
' - packages/agent/src/harness/types.ts: CompactionEntry
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: readPathToRootOrCompaction
' Observed behavior: pi derives context from the compaction-trimmed branch path.
' Design reason: preserve current SQLite cache, repair, and context-boundary semantics.
' Java divergence: GaussDB adds a durable revision and uses recursive CTE only to repair the cache.

actor "Agent Runtime" as runtime
participant "Memory Service" as memory
database "Centralized GaussDB" as db
participant "Context Rebuilder" as rebuild

runtime -> memory : loadContext(sessionId)
memory -> db : read session revision and active leaf
memory -> db : read and validate cached branch
alt cache valid
  db --> memory : cached root-to-tip path
else cache missing or invalid
  memory -> db : recursive canonical parent query
  memory -> db : replace branch cache in savepoint
  db --> memory : repaired root-to-tip path
end
memory -> rebuild : path, revision, and leaf
rebuild -> rebuild : trim at latest compaction boundary
rebuild -> rebuild : derive model, thinking, and active tools
rebuild -> rebuild : project messages and retained tail
rebuild -> rebuild : apply custom projectors
rebuild --> memory : context snapshot
memory --> runtime : context snapshot

@enduml
