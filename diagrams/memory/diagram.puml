@startuml memory-architecture
!pragma layout smetana
title CampusClaw GaussDB Session Storage
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionStorage
' - packages/agent/src/harness/session/repository.ts: SessionRepository
' - packages/storage/sqlite-node/src/sqlite/repo.ts: SqliteSessionBackend
' - packages/storage/sqlite-node/src/sqlite/migrations.ts: applyMigrations
' Observed behavior: pi runs a local SQLite migration runner and records completed IDs.
' Target-only architecture change: the CampusClaw release path owns centralized GaussDB DDL.
' Product constraint: target table names use the t_ prefix.
' Target-only Java default: use MyBatis Spring Boot Starter 3.0.4 with DTO mappers.
' Design reason: schema lifecycle is outside each AgentService runtime instance.

actor "Agent Runtime" as runtime
actor "CampusClaw Database Release Platform" as release

package "Java Session Layer" {
  [Memory Session Application Service] as app
  [Session Repository] as repository
  [Session Storage] as storage
  [Repository Serial Queue] as queue
}

package "GaussDB Persistence Adapter" {
  [Spring Transaction Manager] as tx
  [MyBatis Session Mappers] as sql
}

database "Centralized GaussDB\nCampusClaw Session tables" as db

runtime --> app
app --> repository : create open list delete fork
app --> storage : append read branch context
repository --> queue : serialize operations
storage --> queue : serialize operations
queue --> tx : execute transaction
tx --> sql
sql --> db
release --> db : apply DDL before application rollout

note right of db
The application schema has seven Session tables.
Table names use the t_ prefix.
Columns, keys, indexes, and transaction behavior
preserve the mapped pi Session semantics.
IDs use VARCHAR(128), types use VARCHAR(64),
cwd uses VARCHAR(512), sequences use BIGINT,
time uses TIMESTAMPTZ(3), and JSON uses JSONB.
end note

note bottom of release
This release component is target-only.
It is the only schema upgrade authority.
The concrete migration product is not selected here.
Its history and lock metadata are outside the Session schema.
end note

note bottom of sql
AgentService does not create a migrations table
and does not execute DDL at startup.
end note

@enduml

@startuml memory-write-transaction
title CampusClaw GaussDB Session Write Transactions
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: SqliteSessionConnection.create
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: SqliteSessionConnection.appendEntry
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: appendEntryToBranchCache
' - packages/storage/sqlite-node/src/sqlite/repo.ts: SqliteSessionBackend.delete
' Observed behavior: pi create, append, and delete use an explicit transaction order.
' Target adaptation: preserve the row semantics and order with CampusClaw table names.
' Product constraint: target table names use the t_ prefix.
' Design reason: do not add revision, idempotency, row locks, or cascade delete.

actor "Agent Runtime" as runtime
participant "Session Service" as service
participant "Repository Serial Queue" as queue
database "Centralized GaussDB" as db

runtime -> service : write command
service -> queue : enqueue
queue -> db : begin

alt create session
  queue -> db : insert t_sessions
  queue -> db : insert t_session_sequences
  queue -> db : insert t_session_materialized
else append entry
  queue -> db : select t_session_sequences.next_seq
  queue -> db : insert t_session_entries
  queue -> db : update t_session_sequences
  queue -> db : update t_session_materialized
  queue -> db : insert t_entry_materialized when required
  queue -> db : update t_sessions.active_leaf_id
  queue -> db : update t_branch_entries and t_branch_tips
else delete session
  queue -> db : delete t_branch_tips
  queue -> db : delete t_branch_entries
  queue -> db : delete t_session_entries
  queue -> db : delete t_entry_materialized
  queue -> db : delete t_session_materialized
  queue -> db : delete t_session_sequences
  queue -> db : delete t_sessions
end

alt every statement succeeds
  queue -> db : commit
  queue --> service : success
else any statement fails
  queue -> db : rollback
  queue --> service : storage error
end

service --> runtime : result

@enduml

@startuml memory-data-model
title CampusClaw GaussDB Session Data Model
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBorderColor #53657D
skinparam classBackgroundColor #F7F9FC

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/migrations.ts: ensureMigrationsTable
' - packages/storage/sqlite-node/src/sqlite/migrations/001_initial.sql: lines 1-59
' - packages/storage/sqlite-node/src/sqlite/migrations/002_branch_tips.sql: lines 1-12
' - packages/agent/src/harness/session/repository.ts: createTimestamp
' - packages/storage/sqlite-node/src/sqlite/storage/session-entries.ts: encodeEntry
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts: serializeSummary
' Observed behavior: pi has seven Session tables and one SQLite migration ledger.
' Target-only architecture change: CampusClaw maps only the seven Session tables.
' Product constraint: target table names use the t_ prefix.
' Target adaptation: preserve columns, nullability, key semantics, and index columns.
' Type adaptation: use bounded VARCHAR, BIGINT, TIMESTAMPTZ(3), and JSONB.
' Design reason: the centralized database release path owns schema upgrade metadata.

class "t_sessions" as sessions <<table>> {
  id : varchar(128) [PK]
  --
  created_at : timestamptz(3)
  cwd : varchar(512)
  parent_session_id : varchar(128) [nullable]
  metadata : jsonb [nullable]
  active_leaf_id : varchar(128) [nullable]
}

class "t_session_entries" as session_entries <<table>> {
  session_id : varchar(128) [PK]
  id : varchar(128) [PK]
  --
  entry_seq : bigint [UQ with session_id]
  parent_id : varchar(128) [nullable]
  type : varchar(64)
  timestamp : timestamptz(3)
  payload : jsonb
}

class "t_session_sequences" as session_sequences <<table>> {
  session_id : varchar(128) [PK]
  --
  next_seq : bigint
}

class "t_branch_entries" as branch_entries <<cache>> {
  session_id : varchar(128) [PK]
  branch_id : varchar(128) [PK]
  entry_id : varchar(128) [PK]
  --
  entry_seq : bigint
}

class "t_branch_tips" as branch_tips <<cache>> {
  session_id : varchar(128) [PK]
  tip_id : varchar(128) [PK]
  --
  branch_id : varchar(128) [UQ with session_id]
}

class "t_session_materialized" as session_materialized <<projection>> {
  session_id : varchar(128) [PK]
  --
  payload : jsonb
}

class "t_entry_materialized" as entry_materialized <<projection>> {
  session_id : varchar(128) [PK]
  entry_seq : bigint [PK]
  type : varchar(64) [PK]
  --
  payload : jsonb
}

sessions .. session_entries : logical session ownership
sessions .. session_sequences : logical sequence ownership
sessions .. session_materialized : logical projection ownership
session_entries .. session_entries : logical parent_id
session_entries .. entry_materialized : logical entry_seq source
session_entries .. branch_entries : logical path membership
session_entries .. branch_tips : logical tip target
branch_tips .. branch_entries : logical branch identity

note bottom of session_entries
There are no physical foreign keys or checks.
parent_id is the authoritative tree relation.
Payload uses JSONB and timestamp uses TIMESTAMPTZ(3).
end note

note bottom of branch_entries
t_branch_entries and t_branch_tips are derived caches.
They can be rebuilt from t_session_entries.parent_id.
end note

@enduml

@startuml memory-context-rebuild
title CampusClaw GaussDB Context Rebuild
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: readPathToRootOrCompaction
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: rebuildCachedBranch
' - packages/agent/src/harness/session/session.ts: buildSessionContext
' Observed behavior: pi reads a validated cached branch and trims it at compaction.
' Target adaptation: run equivalent queries against CampusClaw t_ tables.
' Product constraint: target table names use the t_ prefix.
' Design reason: context semantics do not change with the database engine.

actor "Agent Runtime" as runtime
participant "Session Service" as service
participant "Repository Serial Queue" as queue
database "Centralized GaussDB" as db
participant "Context Rebuilder" as rebuild

runtime -> service : loadContext(sessionId)
service -> queue : enqueue read
queue -> db : read t_sessions.active_leaf_id
queue -> db : read and validate t_branch_entries and t_branch_tips
alt cache valid
  db --> queue : cached root-to-tip path
else cache missing or invalid
  queue -> db : recursive t_session_entries.parent_id query
  queue -> db : replace branch cache in savepoint
  db --> queue : repaired root-to-tip path
end
queue --> service : path
service -> rebuild : path
rebuild -> rebuild : trim at compaction boundary
rebuild -> rebuild : derive model thinking and active tools
rebuild -> rebuild : project context messages
rebuild --> service : context
service --> runtime : context

@enduml
