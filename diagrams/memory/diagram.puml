@startuml memory-architecture
!pragma layout smetana
title Java GaussDB Storage With SQLite-Aligned Schema
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionStorage
' - packages/agent/src/harness/session/repository.ts: SessionRepository
' - packages/storage/sqlite-node/src/sqlite/repo.ts: SqliteSessionBackend
' - packages/storage/sqlite-node/src/sqlite/migrations.ts: applyMigrations
' Observed behavior: one serialized repository owns SQLite session operations.
' Target adaptation: replace the driver and SQL dialect without changing table or column names.
' Design reason: the user requires physical SQLite schema alignment and no database extensions.

actor "Agent Runtime" as runtime

package "Java Session Layer" {
  [Memory Session Application Service] as app
  [Session Repository] as repository
  [Session Storage] as storage
  [Migration Runner] as migration
  [Repository Serial Queue] as queue
}

package "GaussDB JDBC Adapter" {
  [JDBC Transaction Manager] as tx
  [SQLite-Aligned SQL] as sql
}

database "Centralized GaussDB\nSQLite-aligned tables" as db

runtime --> app
app --> repository : create open list delete fork
app --> storage : append read branch context
repository --> queue : serialize operations
storage --> queue : serialize operations
queue --> tx : execute transaction
migration --> tx : apply 001 and 002
tx --> sql
sql --> db

note right of db
Tables and columns match SQLite.
Only SQLite WITHOUT ROWID syntax is removed.
Native semantic types and explicit lengths are used.
IDs use VARCHAR(128), types use VARCHAR(64),
cwd uses VARCHAR(512), sequences BIGINT, time TIMESTAMPTZ(3), and JSON JSONB.
end note

note bottom of sql
No revision, operation, checksum,
foreign key, check, or search table.
end note

@enduml

@startuml memory-write-transaction
title SQLite-Aligned GaussDB Write Transactions
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: create and appendEntry
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: appendEntryToBranchCache
' - packages/storage/sqlite-node/src/sqlite/repo.ts: delete
' Observed behavior: create, append, and delete use explicit SQLite transaction order.
' Target adaptation: execute the same table writes through JDBC and GaussDB SQL syntax.
' Design reason: do not add revision, idempotency, row-lock protocol, or cascade delete.

actor "Agent Runtime" as runtime
participant "Session Service" as service
participant "Repository Serial Queue" as queue
database "Centralized GaussDB" as db

runtime -> service : write command
service -> queue : enqueue
queue -> db : begin

alt create session
  queue -> db : insert sessions
  queue -> db : insert session_sequences
  queue -> db : insert session_materialized
else append entry
  queue -> db : select session_sequences.next_seq
  queue -> db : insert session_entries
  queue -> db : update session_sequences
  queue -> db : update session_materialized
  queue -> db : insert entry_materialized when required
  queue -> db : update sessions.active_leaf_id
  queue -> db : update branch_entries and branch_tips
else delete session
  queue -> db : delete branch_tips
  queue -> db : delete branch_entries
  queue -> db : delete session_entries
  queue -> db : delete entry_materialized
  queue -> db : delete session_materialized
  queue -> db : delete session_sequences
  queue -> db : delete sessions
end

alt every statement succeeds
  queue -> db : commit
  queue --> service : success
else any statement fails
  queue -> db : rollback
  queue --> service : storage error
end

service --> runtime : result

@enduml

@startuml memory-data-model
title SQLite-Aligned GaussDB Data Model
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBorderColor #53657D
skinparam classBackgroundColor #F7F9FC

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/migrations.ts: ensureMigrationsTable
' - packages/storage/sqlite-node/src/sqlite/migrations/001_initial.sql: lines 1-59
' - packages/storage/sqlite-node/src/sqlite/migrations/002_branch_tips.sql: lines 1-12
' - packages/agent/src/harness/session/repository.ts: createTimestamp
' - packages/storage/sqlite-node/src/sqlite/storage/session-entries.ts: encodeEntry
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts: serializeSummary
' Observed behavior: the final SQLite core schema has exactly eight logical tables.
' Target adaptation: preserve names, columns, nullability, keys, and indexes.
' Target-only product constraint: IDs use VARCHAR(128), types use VARCHAR(64), and cwd uses VARCHAR(512).
' Type adaptation: sequences use BIGINT, timestamps use TIMESTAMPTZ(3), and JSON documents use JSONB.
' Design reason: omit SQLite WITHOUT ROWID and add no other database structure.

class "migrations" as migrations <<table>> {
  id : varchar(128) [PK]
  --
  applied_at : timestamptz(3)
}

class "sessions" as sessions <<table>> {
  id : varchar(128) [PK]
  --
  created_at : timestamptz(3)
  cwd : varchar(512)
  parent_session_id : varchar(128) [nullable]
  metadata : jsonb [nullable]
  active_leaf_id : varchar(128) [nullable]
}

class "session_entries" as session_entries <<table>> {
  session_id : varchar(128) [PK]
  id : varchar(128) [PK]
  --
  entry_seq : bigint [UQ]
  parent_id : varchar(128) [nullable]
  type : varchar(64)
  timestamp : timestamptz(3)
  payload : jsonb
}

class "session_sequences" as session_sequences <<table>> {
  session_id : varchar(128) [PK]
  --
  next_seq : bigint
}

class "branch_entries" as branch_entries <<cache>> {
  session_id : varchar(128) [PK]
  branch_id : varchar(128) [PK]
  entry_id : varchar(128) [PK]
  --
  entry_seq : bigint
}

class "branch_tips" as branch_tips <<cache>> {
  session_id : varchar(128) [PK]
  tip_id : varchar(128) [PK]
  --
  branch_id : varchar(128) [UQ]
}

class "session_materialized" as session_materialized <<projection>> {
  session_id : varchar(128) [PK]
  --
  payload : jsonb
}

class "entry_materialized" as entry_materialized <<projection>> {
  session_id : varchar(128) [PK]
  entry_seq : bigint [PK]
  type : varchar(64) [PK]
  --
  payload : jsonb
}

sessions .. session_entries : logical session ownership
sessions .. session_sequences : logical sequence ownership
sessions .. session_materialized : logical projection ownership
session_entries .. session_entries : logical parent_id
session_entries .. entry_materialized : logical entry_seq source
session_entries .. branch_entries : logical path membership
session_entries .. branch_tips : logical tip target
branch_tips .. branch_entries : logical branch identity

note bottom of session_entries
There are no physical foreign keys or checks.
parent_id is the authoritative tree relation.
Payload uses JSONB and timestamp uses TIMESTAMPTZ(3).
end note

note bottom of branch_entries
branch_entries and branch_tips are derived caches.
Migration 002 clears both cache generations.
end note

note bottom of migrations
Records database upgrade scripts that already completed.
Existing IDs are skipped; no checksum or version column.
end note

@enduml

@startuml memory-context-rebuild
title SQLite-Aligned GaussDB Context Rebuild
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: readPathToRootOrCompaction
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts: rebuildCachedBranch
' - packages/agent/src/harness/session/session.ts: buildSessionContext
' Observed behavior: SQLite reads a validated cached branch and trims it at compaction.
' Target adaptation: run equivalent queries against tables with the same names.
' Design reason: context semantics must not change with the database engine.

actor "Agent Runtime" as runtime
participant "Session Service" as service
participant "Repository Serial Queue" as queue
database "Centralized GaussDB" as db
participant "Context Rebuilder" as rebuild

runtime -> service : loadContext(sessionId)
service -> queue : enqueue read
queue -> db : read sessions.active_leaf_id
queue -> db : read and validate branch_entries and branch_tips
alt cache valid
  db --> queue : cached root-to-tip path
else cache missing or invalid
  queue -> db : recursive session_entries.parent_id query
  queue -> db : replace branch cache in savepoint
  db --> queue : repaired root-to-tip path
end
queue --> service : path
service -> rebuild : path
rebuild -> rebuild : trim at compaction boundary
rebuild -> rebuild : derive model thinking and active tools
rebuild -> rebuild : project context messages
rebuild --> service : context
service --> runtime : context

@enduml
