  actor "Final client" as CampusClient
  component "CampusMate public upload\n/mate-service/v1/chats/{chat_id}/attachments" as PublicUpload
  database "Mate Chat Store\nchat_id to session_id" as MateChatStore
  component "CampusMate Attachment Service\nany Pod" as AttachmentService
  package "Shared openGauss" as AttachmentDatabase {
    database "t_attachment\npermanent identity and state" as AttachmentDb
    database "t_attachment_active_detail\nactive lifecycle metadata" as AttachmentDetail
  }
  cloud "Private OBS\nkey = attachment_id\nimmutable object body" as AttachmentObs
  component "CampusMate scan and delete worker" as AttachmentWorker
  component "agent-service Pod A" as AgentPodA
  component "agent-service Pod B" as AgentPodB
  database "RuntimeSessionStore\nprojected metadata snapshot" as RuntimeStore

  CampusClient --> PublicUpload : chat_id, multipart upload, and poll READY
  PublicUpload --> MateChatStore : authorize chat_id and resolve session_id
  MateChatStore --> AttachmentService : internal session_id
  AttachmentService --> AttachmentDb : create identity and status row
  AttachmentService --> AttachmentDetail : create active detail
  AttachmentService --> AttachmentObs : put attachment_id and body stream
  AttachmentWorker --> AttachmentDetail : lease, retry, and cleanup fields
  AttachmentWorker --> AttachmentObs : scan or delete by attachment_id
  AttachmentWorker --> AttachmentDb : transition lifecycle status
  AttachmentWorker --> AttachmentDetail : remove after OBS delete
  AgentPodA --> AttachmentService : session_id plus ordered IDs\ninternal batch resolve
  AgentPodB --> AttachmentService : same session_id and IDs\nafter Pod change
  AgentPodA --> AttachmentService : internal content stream
  AgentPodB --> AttachmentService : internal content stream
  AttachmentService --> AttachmentDb : authorize session and validate status
  AttachmentService --> AttachmentDetail : validate active metadata
  AttachmentService --> AttachmentObs : open attachment_id and stream body
  AgentPodA --> RuntimeStore : id, name, MIME, size, sha256
  AgentPodB --> RuntimeStore : restore metadata snapshot
}

note right of AttachmentDb
  Permanent row:
  attachment_id, session_id, status,
  created_at, deleted_at
end note

note right of AttachmentDetail
  Active fields support MIME and size checks,
  SHA-256 integrity, reference protection,
  24-hour cleanup, and worker recovery.
end note

note bottom of OpenClawAttachment
  The Gateway owns the attachment bytes for this request.
  This is an implemented product boundary, not a defect.
end note

note bottom of JavaAttachment
  General attachment input remains outside the v1 wire contract.
end note

note bottom of CampusAttachment
  Public clients use chat_id and never receive session_id.
  Attachment metadata and Runtime use session_id and never store chat_id.
  WebSocket carries attachment IDs only.
  The OBS Object Key is exactly attachment_id.
  Resolve returns no OBS URL or credential.
  Runtime never accesses OBS directly and writes no local file.
  OBJECT_KEY_CONFLICT remains quarantined from ordinary deletion;
  only audited reconciliation may remove an object after ownership proof.
  After OBS deletion, active detail is removed and the permanent
  DELETED tombstone retains only the five identity and audit fields.
end note
@enduml
