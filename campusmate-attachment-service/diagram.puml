@startuml attachment_upload_and_scan_flow
title Attachment streaming upload and asynchronous scan

' Source evidence (pi-mono fc85bdd88be93b1e9a6b6bcfa41c684282ec79cc):
' packages/agent/src/agent.ts, prompt(), lines 336-395
' packages/ai/src/types.ts, ImageContent, lines 345-349
' Source evidence (pi-mono-java 1f7a5423219edfa4519d8719f1cc8a188ed72873):
' modules/ai/src/main/java/com/campusclaw/ai/types/UserMessage.java, lines 20-31
' modules/ai/src/main/java/com/campusclaw/ai/types/ContentBlock.java, lines 17-24
' modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, lines 9-18
' docs/plans/ws-chat-followups.md, lines 12-37
' External evidence:
' Huawei OBS Java SDK streaming upload: obs_21_0602.html and obs_21_0604.html
' RFC 7240: respond-async and wait HTTP preferences
' Observed behavior: both source baselines support inline image content but do
' not implement a generic attachment upload, scan, state, or OBS reference API.
' Target design: mate-service streams one known-length file to shared OBS,
' persists metadata in openGauss, and scans asynchronously before READY.
' Design reason: keep file bytes out of Chat Frames, local disk, and database rows.
' Security hardening: uploaded scripts remain untrusted bytes and are never executed.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "CampusMate client" as Client
participant "mate-service\nAttachment API Pod A" as API
database "Shared openGauss" as DB
participant "Shared private OBS" as OBS
participant "Scan Worker Pod B" as Worker
participant "Security Scanner" as Scanner

Client -> API : POST multipart file\nX-Attachment-Size and Prefer
API -> API : authorize user and session;\nvalidate 1..20 MiB
API -> API : generate attachment_id and\nrandom opaque object_key
API -> DB : INSERT status=UPLOADING\nexpected_size and expires_at
DB --> API : committed row
API -> OBS : streaming PUT(contentLength)\nwhile count and SHA-256
OBS --> API : object ETag
API -> API : require actual size = declared size;\nverify file part EOF after N bytes
API -> DB : conditional UPDATE PROCESSING,\nsize, digest and ETag
DB --> API : row_version advanced

alt Prefer wait=N and scan reaches a terminal state within min(N,10)
  API -> Worker : make PROCESSING task eligible
  Worker -> DB : claim short lease and commit
  Worker -> OBS : streaming GET immutable object
  OBS --> Worker : bounded content stream
  Worker -> Scanner : sniff MIME and scan stream
  Scanner --> Worker : safe, blocked, or terminal failure
  alt safe result
    Worker -> DB : conditional UPDATE READY;\nrelease lease
    DB --> API : READY observed
    API --> Client : 201 READY and Location
  else blocked result
    Worker -> DB : conditional UPDATE BLOCKED;\nrelease lease
    DB --> API : BLOCKED observed
    API --> Client : 422 and Location
  else terminal scan failure
    Worker -> DB : conditional UPDATE FAILED;\nrelease lease
    DB --> API : FAILED observed
    API --> Client : 503 and Location
  end
else default or respond-async, or wait expires
  API --> Client : 202 PROCESSING, Location, Retry-After
  Worker -> DB : claim short lease and commit
  Worker -> OBS : streaming GET immutable object
  OBS --> Worker : bounded content stream
  Worker -> Scanner : sniff MIME and scan stream
  Scanner --> Worker : safe, blocked, or failure
  Worker -> DB : conditional terminal/retry update;\nrelease lease
end

Client -> API : GET attachment status
API -> DB : read by session_id and attachment_id
DB --> API : current safe projection
API --> Client : PROCESSING, READY, BLOCKED, or FAILED

note over API,OBS
No Pod-local file and no complete byte array.
At most 1 MiB of application in-flight buffers
per upload. OBS slowdown propagates backpressure.
end note

note over DB,Worker
OBS I/O and scanning never hold a DB transaction.
An expired lease can be recovered by another Pod.
Only READY can be resolved for chat.send.
end note
@enduml

@startuml attachment_obs_opengauss_storage_split
!pragma layout elk
title Attachment OBS and openGauss responsibility split
left to right direction

' Source evidence (pi-mono fc85bdd88be93b1e9a6b6bcfa41c684282ec79cc):
' packages/ai/src/types.ts, ImageContent, lines 345-349
' Source evidence (pi-mono-java 1f7a5423219edfa4519d8719f1cc8a188ed72873):
' modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, lines 9-18
' External evidence: openGauss 7.0.0-RC3 SQL Reference, Binary Types.
' Observed behavior: source images are inline base64; neither baseline defines
' a shared large-object authority for generic PDF, script, or document inputs.
' Target design: shared OBS owns immutable bytes and shared openGauss owns the
' resource directory, state machine, authorization binding, and worker leases.
' Architecture change: multiple Pods depend only on shared durable services,
' never on process memory, local disk, sticky routing, or a deterministic path.
' Design reason: isolate large-object throughput from relational state queries,
' WAL, database replication, and database backup and restore operations.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam ComponentBorderColor #475569
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #475569
skinparam DatabaseBackgroundColor #F8FAFC

rectangle "mate-service deployment" as Mate {
  component "Attachment API Pod A" as PodA
  component "Attachment API Pod B" as PodB
  component "Scan/Delete Worker Pod C" as PodC
  interface "AttachmentContentStore" as Port
  component "ObsAttachmentContentStore" as Adapter

  PodA --> Port : stream put/open/stat/delete
  PodB --> Port : stream put/open/stat/delete
  PodC --> Port : stream open/stat/delete
  Port -down-> Adapter : implemented by
}

database "Shared openGauss\nmetadata ledger" as DB {
  rectangle "attachment row" as Row {
    card "attachment_id PK" as AId
    card "session_id" as SId
    card "random object_key UK" as Key
    card "status and row_version" as Status
    card "size, SHA-256 and MIME" as Integrity
    card "referenced and expiry" as Reference
    card "lease and retry fields" as Lease
  }
}

cloud "Shared private OBS\nimmutable file bytes" as OBS
component "agent-service Pod D" as Agent

PodA --> DB : metadata transactions
PodB --> DB : metadata transactions
PodC --> DB : short lease and state transactions
Adapter --> OBS : TLS, private bucket, SSE
Agent --> PodB : internal resolve and content stream

note bottom of DB
No BLOB, BYTEA, Base64, URL, or credentials.
Rows are the cross-Pod directory and state authority.
DELETED rows remain as non-reusable ID tombstones.
end note

note bottom of OBS
One original object per attachment_id.
Object keys are random and internal.
No public deterministic bucket or prefix contract.
File names never participate in object keys.
end note

note bottom of Mate
Pod memory contains bounded in-flight chunks only.
There is no local file, temporary directory,
authoritative Java Map, or complete file cache.
end note
@enduml

@startuml attachment_cross_pod_resolution_flow
title Cross-Pod attachment resolution and content streaming

' Source evidence (pi-mono fc85bdd88be93b1e9a6b6bcfa41c684282ec79cc):
' packages/agent/src/agent.ts, prompt(), lines 336-395
' Source evidence (pi-mono-java 1f7a5423219edfa4519d8719f1cc8a188ed72873):
' modules/ai/src/main/java/com/campusclaw/ai/types/UserMessage.java, lines 20-31
' modules/ai/src/main/java/com/campusclaw/ai/types/ContentBlock.java, lines 17-24
' docs/plans/ws-chat-followups.md, lines 12-37
' Observed behavior: the current Java message union has no generic attachment
' reference or cross-service content resolver.
' Target design: agent-service resolves one ordered attachment batch atomically,
' then streams each fixed attachment through mate-service using the stored digest.
' Security hardening: agent-service never receives object keys, OBS URLs, bucket
' names, or credentials; knowing an attachment_id alone does not authorize access.
' Design reason: the upload Pod and read Pod can differ because both use the same
' shared openGauss directory and private OBS content authority.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

participant "agent-service Pod D" as Agent
participant "Attachment API Pod B" as API
database "Shared openGauss" as DB
participant "Shared private OBS" as OBS
participant "Model input adapter" as Model

Agent -> API : POST /internal/v1/attachments:resolve\nservice token, session_id, ordered IDs
API -> API : authenticate immutable\nagent-service principal
API -> DB : BEGIN; lock all IDs in stable order
DB --> API : matching rows
API -> API : require same session, READY,\nnot expired or deleted

alt any item fails authorization or state validation
  API -> DB : ROLLBACK
  API --> Agent : one safe INVALID_ATTACHMENT\nor ATTACHMENT_NOT_READY
else complete batch is valid
  API -> DB : set referenced=true; preserve first timestamp;\nclear expiry; increment row_version; COMMIT
  DB --> API : complete ordered snapshots
  API --> Agent : attachment_id, filename, MIME,\nsize and SHA-256 in request order
end

loop each accepted attachment in request order
  Agent -> API : GET content\nsession_id, attachment_id, expected SHA-256
  API -> DB : authorize READY referenced row;\nread internal random object_key
  DB --> API : object locator and trusted metadata
  API -> OBS : streaming GET by internal object_key
  OBS --> API : bounded original byte stream
  API --> Agent : application/octet-stream\nContent-Length and digest
  Agent -> Agent : incrementally verify exact size\nand SHA-256
  Agent -> Model : provider-neutral untrusted content
end

note over Agent,API
Resolve is all-or-nothing. No partial run starts.
Response order equals request order.
There is no content_version because each ID
maps to one immutable object and digest.
end note

note over API,OBS
The content stream propagates cancellation and
backpressure. It never creates a local file or
materializes the complete object in Pod memory.
end note

note over Agent,Model
PDF and scripts are untrusted user content.
They cannot become system or tool instructions.
JavaScript is stored and read, never executed.
end note
@enduml

@startuml attachment_deletion_and_reconciliation
title Attachment deletion and reconciliation

' Source evidence (pi-mono-java 1f7a5423219edfa4519d8719f1cc8a188ed72873):
' docs/plans/ws-chat-followups.md, lines 12-37
' Observed behavior: the baseline lists attachment transport as future work and
' therefore has no implemented deletion, tombstone, lease, or reconciliation flow.
' Target design: one attachment belongs to one Session; unreferenced content can
' be deleted independently, while referenced content is retained until Session deletion.
' Architecture change: OBS and openGauss do not use XA; conditional state changes,
' short leases, idempotent object operations, and periodic reconciliation recover faults.
' Product constraint: v1 has no cross-Session reuse, content versioning, restore,
' reference-counted retention claim, or resumable multipart upload.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "CampusMate client" as Client
participant "mate-service" as Mate
participant "agent-service" as Agent
database "Shared openGauss" as DB
participant "Delete/Reconcile Worker" as Worker
participant "Shared private OBS" as OBS

group Single attachment deletion
  Client -> Mate : DELETE session attachment
  Mate -> DB : conditional read and state update
  alt referenced=true
    DB --> Mate : referenced attachment
    Mate --> Client : 409 ATTACHMENT_REFERENCED
  else unreferenced or already deleting
    DB --> Mate : DELETING persisted or already present
    Mate --> Client : 202 deletion registered
  end
end

group Privileged security revocation
  Mate -> DB : conditional READY to BLOCKED
  DB --> Mate : revocation persisted
  Mate -> Agent : reject future resolve and content
  Agent -> Agent : fail or abort run if bytes are unread
end

group Session deletion
  Client -> Mate : delete Session
  Mate -> Agent : stop or abort Runtime Session
  Agent --> Mate : Runtime no longer reads attachments
  Mate -> DB : mark all Session attachments DELETING;\ncommit durable deletion work
  DB --> Mate : deletion registered
  Mate --> Client : Session deletion accepted
end

group Background delete on any Pod
  Worker -> DB : claim expired DELETING lease; commit
  DB --> Worker : random object_key and row_version
  Worker -> OBS : idempotent DELETE object
  alt object deleted or already absent
    OBS --> Worker : success or NotFound
    Worker -> DB : conditional UPDATE DELETED,\ndeleted_at; clear lease
  else temporary OBS failure
    OBS --> Worker : retryable failure
    Worker -> DB : increment attempt_count; set\nnext_attempt_at; clear lease
  end
end

group Periodic reconciliation
  Worker -> DB : find stale UPLOADING, PROCESSING,\nDELETING, or expired leases
  DB --> Worker : candidate rows
  Worker -> OBS : stat by stored random object_key
  alt UPLOADING row and complete matching object exists
    OBS --> Worker : object metadata
    Worker -> DB : recover PROCESSING or fail safely
  else orphan or invalid object
    OBS --> Worker : object state
    Worker -> OBS : idempotent cleanup
    Worker -> DB : mark FAILED or DELETED tombstone
  end
end

note over DB,OBS
No distributed XA transaction is required.
Database state is authoritative for eligibility;
OBS is authoritative for original file bytes.
NotFound is successful for an idempotent delete.
end note

note over Mate,DB
Unreferenced attachments expire after 24 hours.
DELETED rows remain forever so attachment_id
values are never issued again.
end note
@enduml
