class t_agent_definition <<current Agent>> {
  id: VARCHAR PK
  resource_type: VARCHAR
  version: BIGINT
  enabled: BOOLEAN
  name: VARCHAR UK
  display_name: VARCHAR
  description: TEXT
  role: TEXT
  objective: TEXT
  instructions: TEXT
  tool_policy: TEXT
  safety: TEXT
  completion: TEXT
  response_style: TEXT
  example: TEXT?
  use_cases: JSONB
  created_at: TIMESTAMPTZ
  updated_at: TIMESTAMPTZ
}

class t_agent_models <<models>> {
  agent_id: VARCHAR PK
  model_id: VARCHAR PK
  sort_order: INTEGER UK
}

class t_agent_binding_tools <<binding_tools and permission>> {
  agent_id: VARCHAR PK
  tool_id: VARCHAR PK
  tool_version: BIGINT?
  permission: deny | ask | allow | NULL
}

class t_agent_binding_skills <<binding_skills>> {
  agent_id: VARCHAR PK
  skill_id: VARCHAR PK
  skill_version: BIGINT?
}

t_agent_definition *-- "1..*" t_agent_models : has
t_agent_definition *-- "0..*" t_agent_binding_tools : binds and governs
t_agent_definition *-- "0..*" t_agent_binding_skills : binds

note right of t_agent_definition
name and display_name are VARCHAR(128).
use_cases is a JSON array.
version is the optimistic-lock value.
enabled gates new runtime invocations.
end note

note right of t_agent_models
Only models preserves JSON array order.
model_id is VARCHAR(64).
end note

note bottom of t_agent_binding_tools
tool_id is VARCHAR(64).
NULL tool_version means latest.
NULL permission means inherit Tool permission.
Every permission Tool must also be bound.
end note

note bottom of t_agent_binding_skills
skill_id is VARCHAR(64).
NULL skill_version means latest.
end note

note bottom of t_agent_definition
Base DDL omits physical foreign keys for
GaussDB Distributed compatibility.
The service writes the root and child rows
in one transaction.
end note

@enduml
